<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- fork: a few seconds awake as the TV goes off, to tell the Remote 3 (RemoteSync.kt) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- fork: the XGIMI's battery, which its own software writes only to the log (BatteryLog.kt);
         granted by apply.sh with READ_LOGS=1, never asked for in the app -->
    <uses-permission android:name="android.permission.READ_LOGS" tools:ignore="ProtectedPermissions" />
    <!-- fork: the doorbell card over whatever is playing (granted by apply.sh over ADB) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- See every app that has a TV launcher entry, so the fallback grid and app tiles can list them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- The TV's input list, for the Input quick button when there is no bridge. -->
        <intent><action android:name="android.settings.TV_INPUT_SETTINGS" /></intent>
        <intent><action android:name="com.android.tv.action.VIEW_INPUTS" /></intent>
        <!-- fork: Quick Settings' Picture and Sound on a TV that is not a Sony (the maker's own screens) -->
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SOUND_SETTINGS" /></intent>
        <intent><action android:name="com.android.tv.action.VIEW_SOUND_SETTINGS" /></intent>
        <!-- fork: the XGIMI's rough battery level, from its widget for the Google TV home -->
        <provider android:authorities="tvlauncher.widget" />
        <intent><action android:name="com.google.android.tv.action.VIEW_INPUTS" /></intent>
        <intent><action android:name="android.media.tv.action.SETUP_INPUTS" /></intent>
        <!-- A file picker, for the photos in Home settings (many TVs have none). -->
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:label="Home"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:theme="@style/Home"
        android:usesCleartextTraffic="true"
        android:supportsRtl="false">

        <!-- fork: Keep watching without a bridge (WatchLog.kt). Notification access is granted by
             apply.sh over ADB; the service only reads what apps say is playing. -->
        <service
            android:name=".NowListener"
            android:exported="true"
            android:label="Keep watching"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale">
            <!-- the web home: no longer the Home (the native one is); kept for its built-in pages -->
        </activity>
        <!-- the native home (home/HomeActivity.kt), beside the web one until it takes over as Home -->
        <activity
            android:name=".home.HomeActivity"
            android:exported="true"
            android:label="Home"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/Home"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- fork: quick settings over whatever is playing (home/Quick.kt), its own task so it opens
             over the app, not the home; couchtv://quick is what a Remote 3 button sends -->
        <activity
            android:name=".home.QuickActivity"
            android:exported="true"
            android:theme="@style/Quick"
            android:launchMode="singleInstance"
            android:taskAffinity="app.couchtv.launcher.quick"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="couchtv" android:host="quick" />
            </intent-filter>
            <!-- the remote's dashboard key (the gear on the XGIMI's remote): with the Google TV home
                 switched off, the system asks whoever answers these, so the key opens (and closes)
                 Quick Settings over whatever is playing -->
            <intent-filter>
                <action android:name="android.app.action.TOGGLE_NOTIFICATION_HANDLER_PANEL" />
                <action android:name="android.app.action.OPEN_NOTIFICATION_HANDLER_PANEL" />
                <action android:name="android.app.action.CLOSE_NOTIFICATION_HANDLER_PANEL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver android:name=".home.SleepReceiver" android:exported="false" />
        <!-- fork: the remote's gear button opens Quick Settings (KeyCatcher.kt); switched on by the
             household in Settings, Accessibility -->
        <service
            android:name=".KeyCatcher"
            android:exported="true"
            android:label="@string/keycatcher_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/keycatcher" />
        </service>
    </application>
</manifest>
